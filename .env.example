# First admin account, created only when the database has no users yet.
# If you leave these empty a random password is generated and printed once in the server log
# (and saved to data/admin-initial-password.txt).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Where the database and uploaded files live. Back this folder up.
DATA_DIR=./data

# Set to 1 only if you serve the site over plain http (no TLS) in production.
INSECURE_COOKIES=0
